# ─────────────────────────────────────────────────────────────
# Frontend Environment Variables — copy to .env and fill in values
# Never commit .env to Git (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Backend API URL — used by the Vite dev server proxy.
# In production (Vercel), requests to /api are routed internally
# via vercel.json, so this variable only matters for local dev.
# Example: https://your-app.onrender.com
VITE_API_BASE_URL=https://your-render-backend-url.onrender.com
